{
  // NOTE: To run this app LOCALLY, change Authentication=Active Directory Managed Identity
  // to Authentication=Active Directory Default (which will use 'az login' credentials)
  // Example local connection string:
  // "Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=Northwind;Authentication=Active Directory Default;"
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:REPLACE_SERVER.database.windows.net,1433;Database=Northwind;Authentication=Active Directory Managed Identity;User Id=REPLACE_CLIENT_ID;"
  },
  "ManagedIdentityClientId": "REPLACE_CLIENT_ID",
  "OpenAI": {
    "Endpoint": "REPLACE_ENDPOINT",
    "DeploymentName": "gpt-4o"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
