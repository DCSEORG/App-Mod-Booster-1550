@page
@model ExpenseApp.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"] = "Dashboard";
    Layout = "Shared/_Layout";
}

<!-- Summary Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#eff6ff;">
                    <i class="bi bi-receipt text-primary fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small">Total</div>
                    <div class="fw-bold fs-5">@Model.Expenses.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#eff6ff;">
                    <i class="bi bi-send text-info fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small">Submitted</div>
                    <div class="fw-bold fs-5">@Model.Expenses.Count(e => e.StatusName == "Submitted")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#f0fdf4;">
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small">Approved</div>
                    <div class="fw-bold fs-5">@Model.Expenses.Count(e => e.StatusName == "Approved")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#f0fdf4;">
                    <i class="bi bi-currency-pound text-success fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small">Total (GBP)</div>
                    <div class="fw-bold fs-5">£@Model.Expenses.Sum(e => e.AmountGBP).ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters + Actions -->
<div class="card data-card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <form method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <select name="statusId" class="form-select form-select-sm" style="width:140px;" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                @foreach (var s in Model.Statuses)
                {
                    <option value="@s.StatusId" selected="@(Model.StatusFilter == s.StatusId)">@s.StatusName</option>
                }
            </select>
            <select name="categoryId" class="form-select form-select-sm" style="width:150px;" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.CategoryId" selected="@(Model.CategoryFilter == c.CategoryId)">@c.CategoryName</option>
                }
            </select>
            <select name="userId" class="form-select form-select-sm" style="width:150px;" onchange="this.form.submit()">
                <option value="">All Users</option>
                @foreach (var u in Model.Users)
                {
                    <option value="@u.UserId" selected="@(Model.UserFilter == u.UserId)">@u.UserName</option>
                }
            </select>
        </form>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
            <i class="bi bi-plus-lg"></i> Add Expense
        </button>
    </div>

    <!-- Expenses Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Employee</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Expenses.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No expenses found.</td></tr>
                }
                @foreach (var exp in Model.Expenses)
                {
                    <tr>
                        <td class="text-muted small">@exp.ExpenseId</td>
                        <td>
                            <span class="fw-medium">@exp.UserName</span>
                        </td>
                        <td><span class="text-muted">@exp.CategoryName</span></td>
                        <td><span class="text-muted small">@exp.ExpenseDate.ToString("dd MMM yyyy")</span></td>
                        <td><span class="text-truncate d-inline-block" style="max-width:200px;" title="@exp.Description">@exp.Description</span></td>
                        <td><strong>£@exp.AmountGBP.ToString("N2")</strong></td>
                        <td>
                            @{
                                var badgeCss = exp.StatusName switch
                                {
                                    "Draft"     => "badge-draft",
                                    "Submitted" => "badge-submitted",
                                    "Approved"  => "badge-approved",
                                    "Rejected"  => "badge-rejected",
                                    _           => "badge-draft"
                                };
                            }
                            <span class="badge-status @badgeCss">@exp.StatusName</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/ExpenseDetail?id=@exp.ExpenseId" class="btn btn-sm btn-outline-secondary" title="View/Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (exp.StatusName == "Draft")
                                {
                                    <form method="post" asp-page-handler="Submit" style="display:inline;">
                                        <input type="hidden" name="expenseId" value="@exp.ExpenseId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Submit">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    </form>
                                }
                                @if (exp.StatusName == "Submitted")
                                {
                                    <form method="post" asp-page-handler="Approve" style="display:inline;">
                                        <input type="hidden" name="expenseId" value="@exp.ExpenseId" />
                                        <input type="hidden" name="reviewedBy" value="2" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Approve">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Reject" style="display:inline;">
                                        <input type="hidden" name="expenseId" value="@exp.ExpenseId" />
                                        <input type="hidden" name="reviewedBy" value="2" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" style="display:inline;"
                                      onsubmit="return confirm('Delete this expense?')">
                                    <input type="hidden" name="expenseId" value="@exp.ExpenseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Employee</label>
                        <select name="userId" class="form-select" required>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.UserId">@u.UserName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Category</label>
                        <select name="categoryId" class="form-select" required>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Amount (£)</label>
                        <div class="input-group">
                            <span class="input-group-text">£</span>
                            <input type="number" name="amountGBP" class="form-control"
                                   step="0.01" min="0.01" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Date</label>
                        <input type="date" name="expenseDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Description</label>
                        <input type="text" name="description" class="form-control"
                               placeholder="Brief description of the expense" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
